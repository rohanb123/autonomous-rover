# Copy to /etc/default/rover (setup_pi.sh does it if absent). Read by rover.service.
# Every value is optional; unset = `auto` (probe, log the inventory, degrade to off).
ROVER_MOTORS=auto
ROVER_SERVOS=auto
ROVER_IMU=auto
ROVER_CAMERA=auto
ROVER_MAPPER=http://192.168.50.10:8200
ROVER_LOG_LEVEL=INFO
# Bench mode until rover/calib/calibrate_camera.py has run: a station uploads keyframes only
# (no BEV, no proposals) instead of refusing. Remove once calib.yaml has calibrated_at set.
ROVER_ALLOW_UNCALIBRATED=1
