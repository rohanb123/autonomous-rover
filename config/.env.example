# Copy to config/.env (gitignored). Never commit real tokens. See docs/02 §7.
# Fallback (Maincloud): STDB_URL=https://maincloud.spacetimedb.com (and VITE_STDB_URI in dashboard/.env)

STDB_URL=http://192.168.50.10:3000
STDB_DB=marsrover

# Writer tokens: `curl -X POST $STDB_URL/v1/identity` once per writer (docs/02 §7.1)
STDB_TOKEN_BRAIN=
STDB_TOKEN_MAPPER=
# Mapper identity (hex) from the same /v1/identity reply; used by publish_stdb.sh -> add_writer
STDB_IDENTITY_MAPPER=
# doc 00 §2 names a single STDB_TOKEN; docs/02 §7 splits it per writer. Kept for compatibility.
STDB_TOKEN=

# Grok (xAI) for voice/text mission parsing (P4, gx10/brain/voice/nlu.py). https://console.x.ai
XAI_API_KEY=

# Optional overrides for the brain's health probes (defaults: config/network.yaml, the GX10).
# VISION_URL=http://127.0.0.1:8100
# MAPPER_URL=http://127.0.0.1:8200
# OVERHEAD_URL=http://127.0.0.1:8300
